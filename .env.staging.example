# Non-sensitive demo staging only. Copy to .env.staging.local (ignored).
DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@SESSION_POOLER_HOST:5432/postgres?sslmode=require
MJL_AUTH_MODE=staging
MJL_ENVIRONMENT=demo-staging
MJL_STAGING_ACK=REPLACE_WITH_EXACT_DEMO_ACKNOWLEDGMENT
MJL_AUTH_KEY=REPLACE_WITH_OPENSSL_RAND_HEX_32
APP_BASE_URL=https://REPLACE_WITH_RENDER_HOSTNAME
RESEND_API_KEY=REPLACE_WITH_PRIVATE_RESEND_KEY
EMAIL_FROM="MJL Demo <REPLACE_WITH_VERIFIED_SENDER>"
# Optional; leave empty to use the sender address.
EMAIL_REPLY_TO=
MJL_FRONTEND_DIRECTORY=/app/static
