{
  "$description": "MJL Financement framework-neutral base tokens. Brand-facing values are provisional-brand-foundation.",
  "color": {
    "navy": {"$type": "color", "$value": "#16324f"},
    "actionBlue": {"$type": "color", "$value": "#164f7a"},
    "focusBlue": {"$type": "color", "$value": "#164f7a"},
    "supportBlue": {"$type": "color", "$value": "#7fb3d5"},
    "text": {
      "strong": {"$type": "color", "$value": "#202529"},
      "secondary": {"$type": "color", "$value": "#34414a"},
      "muted": {"$type": "color", "$value": "#5c6870"},
      "inverse": {"$type": "color", "$value": "#ffffff"}
    },
    "surface": {
      "base": {"$type": "color", "$value": "#ffffff"},
      "subtle": {"$type": "color", "$value": "#f5f7f8"},
      "disabled": {"$type": "color", "$value": "#e3e8eb"},
      "selected": {"$type": "color", "$value": "#eaf3f8"}
    },
    "border": {
      "default": {"$type": "color", "$value": "#8a969e"},
      "subtle": {"$type": "color", "$value": "#c8d0d5"},
      "strong": {"$type": "color", "$value": "#5c6870"}
    },
    "status": {
      "successText": {"$type": "color", "$value": "#17633a"},
      "successSurface": {"$type": "color", "$value": "#e8f5ec"},
      "warningText": {"$type": "color", "$value": "#6b4900"},
      "warningSurface": {"$type": "color", "$value": "#fff4cc"},
      "dangerText": {"$type": "color", "$value": "#8a1c1c"},
      "dangerSurface": {"$type": "color", "$value": "#fdecec"},
      "infoText": {"$type": "color", "$value": "#164f7a"},
      "infoSurface": {"$type": "color", "$value": "#eaf3f8"}
    },
    "overlay": {"$type": "color", "$value": "#202529b8"}
  },
  "font": {
    "family": {
      "sans": {"$type": "fontFamily", "$value": ["Arial", "Helvetica", "sans-serif"]}
    },
    "size": {
      "xs": {"$type": "dimension", "$value": "12px"},
      "sm": {"$type": "dimension", "$value": "14px"},
      "md": {"$type": "dimension", "$value": "16px"},
      "lg": {"$type": "dimension", "$value": "20px"},
      "xl": {"$type": "dimension", "$value": "24px"},
      "2xl": {"$type": "dimension", "$value": "32px"}
    },
    "weight": {
      "regular": {"$type": "fontWeight", "$value": 400},
      "medium": {"$type": "fontWeight", "$value": 600},
      "bold": {"$type": "fontWeight", "$value": 700}
    },
    "lineHeight": {
      "compact": {"$type": "number", "$value": 1.25},
      "body": {"$type": "number", "$value": 1.5},
      "relaxed": {"$type": "number", "$value": 1.65}
    }
  },
  "space": {
    "0": {"$type": "dimension", "$value": "0px"},
    "1": {"$type": "dimension", "$value": "4px"},
    "2": {"$type": "dimension", "$value": "8px"},
    "3": {"$type": "dimension", "$value": "12px"},
    "4": {"$type": "dimension", "$value": "16px"},
    "5": {"$type": "dimension", "$value": "20px"},
    "6": {"$type": "dimension", "$value": "24px"},
    "8": {"$type": "dimension", "$value": "32px"},
    "10": {"$type": "dimension", "$value": "40px"},
    "12": {"$type": "dimension", "$value": "48px"},
    "16": {"$type": "dimension", "$value": "64px"}
  },
  "size": {
    "controlCompact": {"$type": "dimension", "$value": "36px"},
    "controlStandard": {"$type": "dimension", "$value": "40px"},
    "touchTarget": {"$type": "dimension", "$value": "44px"},
    "sidebar": {"$type": "dimension", "$value": "256px"},
    "contentMax": {"$type": "dimension", "$value": "1440px"}
  },
  "radius": {
    "control": {"$type": "dimension", "$value": "4px"},
    "card": {"$type": "dimension", "$value": "6px"},
    "panel": {"$type": "dimension", "$value": "8px"},
    "pill": {"$type": "dimension", "$value": "999px"}
  },
  "border": {
    "width": {
      "default": {"$type": "dimension", "$value": "1px"},
      "focus": {"$type": "dimension", "$value": "2px"}
    }
  },
  "shadow": {
    "card": {"$type": "shadow", "$value": {"color": "#16324f14", "offsetX": "0px", "offsetY": "1px", "blur": "4px", "spread": "0px"}},
    "dialog": {"$type": "shadow", "$value": {"color": "#16324f29", "offsetX": "0px", "offsetY": "8px", "blur": "24px", "spread": "0px"}}
  },
  "motion": {
    "duration": {
      "instant": {"$type": "duration", "$value": "0ms"},
      "fast": {"$type": "duration", "$value": "120ms"},
      "standard": {"$type": "duration", "$value": "180ms"},
      "slow": {"$type": "duration", "$value": "240ms"}
    },
    "easing": {
      "standard": {"$type": "cubicBezier", "$value": [0.2, 0, 0, 1]}
    },
    "reduced": {
      "duration": {"$type": "duration", "$value": "0ms"}
    }
  },
  "breakpoint": {
    "compact": {"$type": "dimension", "$value": "390px"},
    "tablet": {"$type": "dimension", "$value": "768px"},
    "desktop": {"$type": "dimension", "$value": "1024px"},
    "wide": {"$type": "dimension", "$value": "1366px"}
  },
  "zIndex": {
    "base": {"$type": "number", "$value": 0},
    "sticky": {"$type": "number", "$value": 100},
    "drawer": {"$type": "number", "$value": 300},
    "dialog": {"$type": "number", "$value": 400},
    "toast": {"$type": "number", "$value": 500}
  },
  "opacity": {
    "disabled": {"$type": "number", "$value": 0.65},
    "overlay": {"$type": "number", "$value": 0.72}
  },
  "table": {
    "rowCompact": {"$type": "dimension", "$value": "40px"},
    "rowStandard": {"$type": "dimension", "$value": "48px"},
    "cellInlineCompact": {"$type": "dimension", "$value": "8px"},
    "cellInlineStandard": {"$type": "dimension", "$value": "12px"}
  }
}
