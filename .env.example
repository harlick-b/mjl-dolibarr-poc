# Local rebuild only. Copy to .env (ignored).
# Replace the placeholder with a generated hex value: openssl rand -hex 24
# Do not reuse production credentials. Hex avoids URL-escaping ambiguity.
POSTGRES_PASSWORD=REPLACE_WITH_GENERATED_LOCAL_HEX
POSTGRES_USER=mjl
POSTGRES_DB=mjl_foundation
MJL_FRONTEND_PORT=5173
MJL_BACKEND_PORT=8000
MJL_AUTH_MODE=local
MJL_ENVIRONMENT=local-development
# Replace with: openssl rand -hex 32
MJL_AUTH_KEY=REPLACE_WITH_GENERATED_AUTH_HEX
APP_BASE_URL=http://localhost:5173
RESEND_API_KEY=REPLACE_WITH_PRIVATE_RESEND_KEY
EMAIL_FROM="MJL <REPLACE_WITH_VERIFIED_SENDER>"
# Optional; leave empty when replies should use the sender address.
EMAIL_REPLY_TO=
# For host backend only, export a complete URL using the local database endpoint.
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE
# Integration tests require a different disposable database named mjl_test_*.
